{$SUPERVISOR_DOMAIN} {
	encode gzip

	# Los lotes del EA son pequeños; esto corta abusos antes de llegar a la API.
	request_body {
		max_size 2MB
	}

	# La Content-Security-Policy la pone la aplicación en /dashboard (solo scripts y estilos
	# propios, sin código en línea); Caddy no la sobrescribe.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# same-origin y no no-referrer: con no-referrer los navegadores envían "Origin: null" en
		# los formularios del propio sitio (login/logout del dashboard) y no se puede verificar.
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy api:8000 {
		header_up X-Request-ID {http.request.uuid}
	}

	log {
		output stdout
		format json
	}
}
