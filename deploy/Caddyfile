{$SUPERVISOR_DOMAIN} {
	encode gzip

	# Los lotes del EA son pequeños; esto corta abusos antes de llegar a la API. Solo la subida
	# de resultados del Strategy Tester (laboratorio, con token de administración) admite hasta
	# 10 MB: un informe HTML de MT5 va en UTF-16 y pesa el doble. La API la limita a 8 MB.
	@subida_backtest path_regexp ^/v1/experiments/[^/]+/backtests$
	@resto {
		not path_regexp ^/v1/experiments/[^/]+/backtests$
	}
	request_body @subida_backtest {
		max_size 10MB
	}
	request_body @resto {
		max_size 2MB
	}

	# La Content-Security-Policy la pone la aplicación en /dashboard (solo scripts y estilos
	# propios, sin código en línea); Caddy no la sobrescribe.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# same-origin y no no-referrer: con no-referrer los navegadores envían "Origin: null" en
		# los formularios del propio sitio (login/logout del dashboard) y no se puede verificar.
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy api:8000 {
		header_up X-Request-ID {http.request.uuid}
	}

	log {
		output stdout
		format json
	}
}
