# Copiar a deploy/.env y completar. El archivo .env real nunca se sube a git.
# Generar claves con:  openssl rand -hex 32

POSTGRES_DB=supervisor
POSTGRES_USER=supervisor
POSTGRES_PASSWORD=

# Token para registrar bots, versiones y despliegues (cabecera Authorization: Bearer ...).
SUPERVISOR_ADMIN_TOKEN=
SUPERVISOR_LOG_LEVEL=INFO
# Dashboard (https://TU_DOMINIO/dashboard): se entra con SUPERVISOR_ADMIN_TOKEN.
# Horas que dura la sesión del navegador antes de pedir el token otra vez.
SUPERVISOR_DASHBOARD_SESSION_HOURS=12

# Worker de operaciones (opcional; estos son los valores por defecto).
# Segundos entre consultas de eventos pendientes.
SUPERVISOR_WORKER_POLL_INTERVAL_SECONDS=2
# Minutos tras un cierre por SL en los que una apertura del mismo bot cuenta como reentrada.
SUPERVISOR_REENTRY_WINDOW_MINUTES=30

# Dominio que apunta a la IP del VPS (registro A). Caddy obtiene el certificado HTTPS solo.
SUPERVISOR_DOMAIN=supervisor.ejemplo.com

# Backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/trading-supervisor
BACKUP_KEEP_DAYS=14
