# Copiar a deploy/.env y completar. El archivo .env real nunca se sube a git.
# Generar claves con:  openssl rand -hex 32

POSTGRES_DB=supervisor
POSTGRES_USER=supervisor
POSTGRES_PASSWORD=

# Token para registrar bots, versiones y despliegues (cabecera Authorization: Bearer ...).
SUPERVISOR_ADMIN_TOKEN=
SUPERVISOR_LOG_LEVEL=INFO
# Dashboard (https://TU_DOMINIO/dashboard): se entra con SUPERVISOR_ADMIN_TOKEN.
# Horas que dura la sesión del navegador antes de pedir el token otra vez.
SUPERVISOR_DASHBOARD_SESSION_HOURS=12

# Worker de operaciones (opcional; estos son los valores por defecto).
# Segundos entre consultas de eventos pendientes.
SUPERVISOR_WORKER_POLL_INTERVAL_SECONDS=2
# Minutos tras un cierre por SL en los que una apertura del mismo bot cuenta como reentrada.
SUPERVISOR_REENTRY_WINDOW_MINUTES=30

# Análisis y estadísticas (opcional; valores por defecto).
# Breakeven: |neto| <= esta fracción del riesgo inicial (0.05 = 5 % de 1 R).
SUPERVISOR_BREAKEVEN_R_FRACTION=0.05
# Operaciones mínimas para calcular Sharpe/Sortino y no avisar de muestra pequeña.
SUPERVISOR_STATS_MIN_SAMPLE=30

# Alertas (sección 15; opcional, valores por defecto). Solo informan: nunca envían órdenes.
# Telegram: paso a paso con `docker compose exec api supervisor-cli telegram setup-help`.
# Vacíos = sin Telegram (las alertas se ven igualmente en https://TU_DOMINIO/dashboard/alertas).
SUPERVISOR_TELEGRAM_BOT_TOKEN=
SUPERVISOR_TELEGRAM_CHAT_ID=
# Activar o desactivar el motor de alertas del worker.
SUPERVISOR_ALERTS_ENABLED=true
# Una alerta resuelta (p. ej. el EA vuelve a latir) no se repite antes de estos minutos.
SUPERVISOR_ALERTS_COOLDOWN_MINUTES=60
# TRAMPA_ACTIVA: se revisan las operaciones abiertas en los últimos N minutos.
SUPERVISOR_ALERTS_TRAP_WINDOW_MINUTES=60
# EA_SIN_LATIDO: minutos sin latido de un terminal antes de avisar.
SUPERVISOR_ALERTS_HEARTBEAT_MINUTES=5
# Sin avisos de latido en fin de semana: de viernes a la hora indicada (UTC) a domingo a la
# hora indicada (UTC).
SUPERVISOR_ALERTS_SKIP_WEEKENDS=true
SUPERVISOR_ALERTS_WEEKEND_START_HOUR_UTC=21
SUPERVISOR_ALERTS_WEEKEND_END_HOUR_UTC=21

# Dominio que apunta a la IP del VPS (registro A). Caddy obtiene el certificado HTTPS solo.
SUPERVISOR_DOMAIN=supervisor.ejemplo.com

# Backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/trading-supervisor
BACKUP_KEEP_DAYS=14
